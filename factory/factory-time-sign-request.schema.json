{
  "$id": "https://product.example/schemas/factory-time-sign-request-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "key_id": { "$ref": "sacrificial-trusted-time-request.schema.json#/$defs/identifier" },
    "result": { "const": "FACTORY_TIME_SIGNATURE_REQUESTED" },
    "schema": { "const": "xz-factory-time-sign-request-v1" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_domain_b64url": { "const": "eHotc2FjcmlmaWNpYWwtdHJ1c3RlZC10aW1lLXJlY2VpcHQtdjEA" },
    "unsigned_receipt_b64url": {
      "maxLength": 15000,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "unsigned_receipt_sha256": { "$ref": "sacrificial-trusted-time-request.schema.json#/$defs/sha256" }
  },
  "required": [
    "schema",
    "key_id",
    "signature_algorithm",
    "signature_domain_b64url",
    "unsigned_receipt_b64url",
    "unsigned_receipt_sha256",
    "result"
