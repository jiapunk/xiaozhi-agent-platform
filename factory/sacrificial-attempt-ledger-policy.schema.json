{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.example/schemas/sacrificial-attempt-ledger-policy-v2.json",
  "title": "Sacrificial Attempt Ledger Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "policy_id",
    "ledger_id",
    "station",
    "authorization_key_id",
    "trusted_time",
    "storage",
    "safety",
    "created_at",
    "expires_at",
    "result",
    "signature_algorithm",
    "signature_b64url"
  ],
  "properties": {
    "schema": { "const": "xz-sacrificial-attempt-ledger-policy-v2" },
    "environment": { "const": "SACRIFICIAL_HARDWARE_AUTHORIZATION" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "ledger_id": { "$ref": "#/$defs/identifier" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture_id", "fixture_version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fixture_id": { "$ref": "#/$defs/identifier" },
        "fixture_version": { "$ref": "#/$defs/identifier" }
      }
    },
    "authorization_key_id": { "$ref": "#/$defs/identifier" },
    "trusted_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "authority_key_id",
        "authority_public_key_sha256",
        "ca_certificate_sha256",
        "client_certificate_sha256",
        "timeout_ms",
        "maximum_response_bytes",
        "tls_minimum_version",
        "mtls_required",
        "redirects_allowed",
        "proxies_allowed"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https://[^/?#]+/v1/factory/trusted-time$",
          "maxLength": 512
        },
        "authority_key_id": { "$ref": "#/$defs/identifier" },
        "authority_public_key_sha256": { "$ref": "#/$defs/sha256" },
        "ca_certificate_sha256": { "$ref": "#/$defs/sha256" },
        "client_certificate_sha256": { "$ref": "#/$defs/sha256" },
        "timeout_ms": { "const": 5000 },
        "maximum_response_bytes": { "const": 16384 },
        "tls_minimum_version": { "const": "1.3" },
        "mtls_required": { "const": true },
        "redirects_allowed": { "const": false },
        "proxies_allowed": { "const": false }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "filesystem_device",
        "directory_inode",
        "claims_directory",
        "root_mode",
        "record_mode",
        "multi_station_supported"
      ],
      "properties": {
        "kind": { "const": "LOCAL_DURABLE_SINGLE_STATION" },
        "filesystem_device": { "type": "integer", "minimum": 0 },
        "directory_inode": { "type": "integer", "minimum": 1 },
        "claims_directory": { "const": "claims" },
        "root_mode": { "const": "0700" },
        "record_mode": { "const": "0400" },
        "multi_station_supported": { "const": false }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_included",
        "executor_invoked",
        "hardware_touched",
        "production_inventory_eligible",
        "deletion_api_included",
        "failure_disposition"
      ],
      "properties": {
        "executor_included": { "const": false },
        "executor_invoked": { "const": false },
        "hardware_touched": { "const": false },
        "production_inventory_eligible": { "const": false },
        "deletion_api_included": { "const": false },
        "failure_disposition": { "const": "QUARANTINE_OR_DESTROY" }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "result": { "const": "SACRIFICIAL_ATTEMPT_LEDGER_POLICY" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_b64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_.-]{1,128}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
