{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.example/schemas/sacrificial-trusted-time-request-v1.json",
  "title": "Sacrificial Trusted Time Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "scope",
    "request_id",
    "nonce_b64url",
    "ledger",
    "authorization",
    "transaction",
    "station",
    "result"
  ],
  "properties": {
    "schema": { "const": "xz-sacrificial-trusted-time-request-v1" },
    "environment": { "const": "SACRIFICIAL_HARDWARE_AUTHORIZATION" },
    "scope": { "const": "SACRIFICIAL_ATTEMPT_CONSUMPTION_TIME" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "nonce_b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "ledger": { "$ref": "#/$defs/ledger" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "transaction": { "$ref": "#/$defs/transaction" },
    "station": { "$ref": "#/$defs/station" },
    "result": { "const": "TRUSTED_TIME_REQUESTED" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_sha256", "policy_id", "ledger_id"],
      "properties": {
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "policy_id": { "$ref": "#/$defs/identifier" },
        "ledger_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "plan_id", "issued_at", "expires_at"],
      "properties": {
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "plan_id": { "$ref": "#/$defs/identifier" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "device_id", "base_mac"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "device_id": { "type": "string", "pattern": "^xz-[0-9a-f]{12}$" },
        "base_mac": { "type": "string", "pattern": "^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$" }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture_id", "fixture_version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fixture_id": { "$ref": "#/$defs/identifier" },
        "fixture_version": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}

