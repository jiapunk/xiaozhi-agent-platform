{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xiaozhi-agent/factory-physical-flash-observation-v1.schema.json",
  "title": "ESP Agent physical factory flash observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "observation_id", "environment", "phase", "transaction", "product",
    "release", "station", "capture", "started_at", "finished_at", "result",
    "signature_algorithm", "signature_b64url"
  ],
  "properties": {
    "schema": { "const": "xz-factory-physical-flash-observation-v1" },
    "observation_id": { "$ref": "#/$defs/identifier" },
    "environment": { "const": "PRODUCTION_FACTORY" },
    "phase": { "const": "PRE_SECURE_DOWNLOAD_LOCK" },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "attempt_id", "device_id", "serial_number", "base_mac"],
      "properties": {
        "transaction_id": { "$ref": "#/$defs/identifier" },
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "device_id": { "type": "string", "pattern": "^xz-[0-9a-f]{12}$" },
        "serial_number": { "$ref": "#/$defs/identifier" },
        "base_mac": { "$ref": "#/$defs/mac" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "board", "hardware_revision", "chip_model", "chip_revision"],
      "properties": {
        "sku": { "const": "VOICE_AGENT_KIT_BOX3" },
        "board": { "const": "esp32s3-box3" },
        "hardware_revision": { "const": 1 },
        "chip_model": { "const": "ESP32-S3" },
        "chip_revision": { "type": "integer", "minimum": 0, "maximum": 999 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing_request_sha256", "signed_artifact_verification_sha256",
        "anti_rollback_secure_version"
      ],
      "properties": {
        "signing_request_sha256": { "$ref": "#/$defs/sha256" },
        "signed_artifact_verification_sha256": { "$ref": "#/$defs/sha256" },
        "anti_rollback_secure_version": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "operators", "fixture_id", "fixture_version",
        "fixture_calibration_sha256", "signing_key_id", "esptool_version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "operators": {
          "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "fixture_id": { "$ref": "#/$defs/identifier" },
        "fixture_version": { "$ref": "#/$defs/identifier" },
        "fixture_calibration_sha256": { "$ref": "#/$defs/sha256" },
        "signing_key_id": { "$ref": "#/$defs/identifier" },
        "esptool_version": { "const": "5.3.1" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport", "port_fingerprint_sha256", "chip_probe_log_sha256",
        "efuse_summary_before_sha256", "efuse_summary_after_sha256",
        "flash_encryption_enabled", "download_manual_encrypt_disabled",
        "secure_download_lock_pending", "raw_readback_pass", "regions"
      ],
      "properties": {
        "transport": { "const": "UART_ROM_DOWNLOAD" },
        "port_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "chip_probe_log_sha256": { "$ref": "#/$defs/sha256" },
        "efuse_summary_before_sha256": { "$ref": "#/$defs/sha256" },
        "efuse_summary_after_sha256": { "$ref": "#/$defs/sha256" },
        "flash_encryption_enabled": { "const": true },
        "download_manual_encrypt_disabled": { "const": true },
        "secure_download_lock_pending": { "const": true },
        "raw_readback_pass": { "const": true },
        "regions": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "prefixItems": [
            { "$ref": "#/$defs/bootloader" },
            { "$ref": "#/$defs/partitionTable" },
            { "$ref": "#/$defs/nvsFactory" },
            { "$ref": "#/$defs/otaData" },
            { "$ref": "#/$defs/application" }
          ],
          "items": false
        }
      }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "result": { "const": "PHYSICAL_FLASH_READBACK_PASS" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]{1,128}$" },
    "mac": { "type": "string", "pattern": "^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "size", "readback_sha256"],
      "properties": {
        "name": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "size": { "type": "integer", "minimum": 1, "maximum": 5771264 },
        "readback_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bootloader": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        { "properties": { "name": { "const": "bootloader" }, "offset": { "const": 0 } } }
      ]
    },
    "partitionTable": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        { "properties": { "name": { "const": "partition_table" }, "offset": { "const": 65536 } } }
      ]
    },
    "nvsFactory": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        { "properties": { "name": { "const": "nvs_factory" }, "offset": { "const": 69632 }, "size": { "const": 24576 } } }
      ]
    },
    "otaData": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        { "properties": { "name": { "const": "ota_data_initial" }, "offset": { "const": 135168 } } }
      ]
    },
    "application": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        { "properties": { "name": { "const": "application" }, "offset": { "const": 262144 } } }
      ]
    }
  }
}
