# M24 compile-only production boot-security profile.
#
# This profile deliberately emits secure-padded, unsigned remote-signing
# inputs. Production private keys must stay in independently operated signing
# services/HSMs and must never be copied into this repository or build worker.
CONFIG_PRODUCT_PRODUCTION_SECURITY_PROFILE=y
# CONFIG_PRODUCT_AGENT_INDICATOR_ACTION_ENABLE is not set
CONFIG_APP_REPRODUCIBLE_BUILD=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB_box3_production.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
# CONFIG_SECURE_BOOT_INSECURE is not set
# CONFIG_SECURE_BOOT_ENABLE_AGGRESSIVE_KEY_REVOKE is not set
# CONFIG_SECURE_BOOT_V2_ALLOW_EFUSE_RD_DIS is not set
# CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT is not set

CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_KEY_SOURCE_EFUSES=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y
# CONFIG_SECURE_DISABLE_ROM_DL_MODE is not set
# CONFIG_SECURE_INSECURE_ALLOW_DL_MODE is not set

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=1
CONFIG_BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD=16
# CONFIG_BOOTLOADER_EFUSE_SECURE_VERSION_EMULATE is not set

# The six ESP32-S3 key blocks are frozen as follows:
#   0..2 Secure Boot RSA-3072 public-key digests
#   3    XTS_AES_128_KEY for flash/PSRAM encryption
#   4    product NVS HMAC_UP key
#   5    product identity HMAC_UP key
CONFIG_PRODUCT_STORAGE_NVS_HMAC_KEY_ID=4
CONFIG_PRODUCT_IDENTITY_HMAC_KEY_ID=5

CONFIG_APP_PROJECT_VER="0.24.0-security-gate"
CONFIG_PRODUCT_OTA_RELEASE_SEQUENCE=24
CONFIG_PRODUCT_OTA_CHANNEL="production"
