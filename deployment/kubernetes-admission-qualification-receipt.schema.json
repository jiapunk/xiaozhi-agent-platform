{
  "$id": "https://xiaozhi-agent.local/schemas/kubernetes-admission-qualification-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "cluster_server": { "format": "uri", "pattern": "^https://[^/?#]+$", "type": "string" },
    "deployment_id": { "maxLength": 32, "pattern": "^[a-z0-9](?:[-a-z0-9]{0,30}[a-z0-9])?$", "type": "string" },
    "evidence_sha256": { "$ref": "#/$defs/sha256" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "kube_system_uid": { "$ref": "#/$defs/uid" },
    "namespace": { "maxLength": 63, "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$", "type": "string" },
    "qualification_id": { "$ref": "#/$defs/identifier" },
    "qualification_tool_sha256": { "$ref": "#/$defs/sha256" },
    "result": { "const": "LIVE_API_SERVER_PASS" },
    "schema": { "const": 1 },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_b64url": { "pattern": "^[A-Za-z0-9_-]{86}$", "type": "string" },
    "signing_key_id": { "$ref": "#/$defs/identifier" },
    "started_at": { "$ref": "#/$defs/timestamp" }
  },
  "required": ["schema", "qualification_id", "result", "deployment_id", "namespace", "admission_receipt_sha256", "cluster_server", "kube_system_uid", "evidence_sha256", "qualification_tool_sha256", "started_at", "finished_at", "signing_key_id", "signature_algorithm", "signature_b64url"],
  "type": "object",
  "$defs": {
    "identifier": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$", "type": "string" },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "timestamp": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string" },
    "uid": { "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "type": "string" }
  }
}
