S3CAM_GATEWAY_ADDRESS=127.0.0.1:8766
S3CAM_GATEWAY_PUBLIC_WS_URL=wss://116-206-93-12.sslip.io:8443/v1/device
S3CAM_GATEWAY_EXPECTED_DEVICE_ID=20:6e:f1:b3:9c:c4
S3CAM_GATEWAY_ALLOWED_DEVICE_IDS=20:6e:f1:b3:9c:c4,28:84:85:b4:ed:10
S3CAM_GATEWAY_BOOTSTRAP_TOKEN_FILE=/etc/xiaozhi-gateway/secrets/bootstrap_token
S3CAM_GATEWAY_DEVICE_BOOTSTRAP_TOKENS_FILE=/etc/xiaozhi-gateway/secrets/device_bootstrap_tokens.json
S3CAM_GATEWAY_SESSION_TOKEN_FILE=/etc/xiaozhi-gateway/secrets/session_token
S3CAM_AGENT_MEMORY_FILE=/var/lib/xiaozhi-gateway/agent-memory.enc
S3CAM_AGENT_MEMORY_KEY_FILE=/etc/xiaozhi-gateway/secrets/memory_key
S3CAM_TEXT_LOCALE=zh-TW
S3CAM_GLYPH_PROVIDER_URL=http://127.0.0.1:8768/glyph-push

# The safe built-in human-voice loopback remains available by setting this to 0.
S3CAM_CLOUD_AI_ENABLED=0
S3CAM_OPENROUTER_ENABLED=1
S3CAM_OPENROUTER_WEB_TOOLS_ENABLED=1
S3CAM_OPENROUTER_API_KEY_FILE=/etc/xiaozhi-gateway/secrets/openrouter_api_key
S3CAM_OPENROUTER_ASR_MODEL=qwen/qwen3-asr-flash-2026-02-10
S3CAM_OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4-flash
S3CAM_OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
S3CAM_OPENROUTER_TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
S3CAM_OPENROUTER_TTS_VOICE=longanlingxi

# Direct-provider profile retained as a later fallback option.
S3CAM_DASHSCOPE_API_KEY_FILE=/etc/xiaozhi-gateway/secrets/dashscope_api_key
S3CAM_DEEPSEEK_API_KEY_FILE=/etc/xiaozhi-gateway/secrets/deepseek_api_key
S3CAM_CLOUD_ASR_MODEL=qwen3-asr-flash
S3CAM_CLOUD_AGENT_MODEL=deepseek-v4-flash
S3CAM_CLOUD_TTS_MODEL=qwen3-tts-flash
S3CAM_CLOUD_TTS_VOICE=Cherry
S3CAM_FFMPEG_PATH=/usr/bin/ffmpeg

# Full-duplex OpenAI Realtime is independent of the fallback text pipeline.
# Enable only after installing the owner-only secret file below.
S3CAM_OPENAI_REALTIME_ENABLED=0
S3CAM_OPENAI_API_KEY_FILE=/etc/xiaozhi-gateway/secrets/openai_api_key
S3CAM_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
S3CAM_OPENAI_REALTIME_VOICE=marin
S3CAM_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Medium balances natural pauses with a faster end-of-turn response.
S3CAM_OPENAI_SEMANTIC_EAGERNESS=medium

# Enable after creating an Alibaba Cloud Model Studio Singapore workspace key.
S3CAM_VOICE_CLONE_ENABLED=0
S3CAM_DASHSCOPE_VOICE_API_KEY_FILE=/etc/xiaozhi-gateway/secrets/dashscope_voice_api_key
S3CAM_VOICE_MANAGEMENT_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/audio/tts/customization
S3CAM_VOICE_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
S3CAM_VOICE_TARGET_MODEL=qwen-audio-3.0-tts-flash
S3CAM_VOICE_PREFIX=myvoice
S3CAM_VOICE_PROFILE_FILE=/var/lib/xiaozhi-gateway/voice-profile.enc
