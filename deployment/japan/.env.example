# No purchased domain is required for the prototype. Replace the example
# address with the server's attached static IPv4, using dashes. For example,
# static IP 203.0.113.10 becomes 203-0-113-10.sslip.io.
# A personally owned domain can replace this later without changing Gateway.
GATEWAY_DOMAIN=203-0-113-10.sslip.io
ACME_EMAIL=owner@example.com

# The one ESP32 currently authorized for this prototype Gateway.
EXPECTED_DEVICE_ID=20:6e:f1:b3:9c:c4

# Optional: Alibaba now recommends workspace-specific Singapore endpoints.
# Leave these commented to use the still-supported shared international URLs.
# DASHSCOPE_ASR_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_TTS_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
