{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-agent.local/schemas/provider-revocation-evidence-manifest-v1.json",
  "title": "M72 public evidence and independent trust manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "qualification_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "environment": { "enum": ["staging", "production"] },
    "deployment_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "oci_release_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "evaluation_time": { "$ref": "provider-revocation-observation.schema.json#/$defs/timestamp" },
    "mtls_dispatch_evaluation_time": { "$ref": "provider-revocation-observation.schema.json#/$defs/timestamp" },
    "app_delivery_evaluation_time": { "$ref": "provider-revocation-observation.schema.json#/$defs/timestamp" },
    "observation_path": { "$ref": "#/$defs/path" },
    "revocation_attestation_path": { "$ref": "#/$defs/path" },
    "revocation_attestation_public_key_path": { "$ref": "#/$defs/path" },
    "expected_revocation_attestation_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "expected_revocation_attestation_provider": { "enum": ["fixture", "provider-credential-audit-authority"] },
    "expected_provider_audit_evidence_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" },
    "mtls_dispatch_receipt_path": { "$ref": "#/$defs/path" },
    "mtls_dispatch_public_key_path": { "$ref": "#/$defs/path" },
    "expected_mtls_dispatch_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "mtls_dispatch_observation_path": { "$ref": "#/$defs/path" },
    "app_delivery_receipt_path": { "$ref": "#/$defs/path" },
    "app_delivery_public_key_path": { "$ref": "#/$defs/path" },
    "expected_app_delivery_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "app_observation_path": { "$ref": "#/$defs/path" },
    "provider_qualification_receipt_path": { "$ref": "#/$defs/path" },
    "provider_qualification_public_key_path": { "$ref": "#/$defs/path" },
    "expected_provider_qualification_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "expected_provider_qualification_config_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" },
    "expected_provider_qualification_tool_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" },
    "app_attestation_receipt_path": { "$ref": "#/$defs/path" },
    "app_attestation_public_key_path": { "$ref": "#/$defs/path" },
    "expected_app_attestation_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "expected_app_attestation_provider": { "enum": ["fixture", "apple-app-attest"] },
    "expected_vendor_evidence_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" },
    "expected_app_binary_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" },
    "deployment_attestation_receipt_path": { "$ref": "#/$defs/path" },
    "deployment_attestation_public_key_path": { "$ref": "#/$defs/path" },
    "expected_deployment_attestation_key_id": { "$ref": "provider-revocation-observation.schema.json#/$defs/identifier64" },
    "expected_deployment_attestation_provider": { "enum": ["fixture", "kubernetes-cluster-authority"] },
    "expected_workload_evidence_sha256": { "$ref": "provider-revocation-observation.schema.json#/$defs/sha256" }
  },
  "required": [
    "schema", "qualification_id", "environment", "deployment_id", "oci_release_id",
    "evaluation_time", "mtls_dispatch_evaluation_time", "app_delivery_evaluation_time",
    "observation_path", "revocation_attestation_path", "revocation_attestation_public_key_path",
    "expected_revocation_attestation_key_id", "expected_revocation_attestation_provider",
    "expected_provider_audit_evidence_sha256", "mtls_dispatch_receipt_path",
    "mtls_dispatch_public_key_path", "expected_mtls_dispatch_key_id",
    "mtls_dispatch_observation_path", "app_delivery_receipt_path",
    "app_delivery_public_key_path", "expected_app_delivery_key_id", "app_observation_path",
    "provider_qualification_receipt_path", "provider_qualification_public_key_path",
    "expected_provider_qualification_key_id", "expected_provider_qualification_config_sha256",
    "expected_provider_qualification_tool_sha256", "app_attestation_receipt_path",
    "app_attestation_public_key_path", "expected_app_attestation_key_id",
    "expected_app_attestation_provider", "expected_vendor_evidence_sha256",
    "expected_app_binary_sha256", "deployment_attestation_receipt_path",
    "deployment_attestation_public_key_path", "expected_deployment_attestation_key_id",
    "expected_deployment_attestation_provider", "expected_workload_evidence_sha256"
  ],
  "$defs": {
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 }
  }
}
