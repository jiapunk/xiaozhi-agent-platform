{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-agent.local/schemas/managed-token-rotation-preflight-v1.json",
  "title": "Managed Token Rotation Software Preflight Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "software_only",
    "domain",
    "transition",
    "observed_at_unix",
    "max_token_ttl_seconds",
    "current_revision",
    "target_revision",
    "current_active_key_id",
    "target_active_key_id",
    "cutover_unix",
    "minimum_drain_until_unix",
    "old_key_verify_until_unix"
  ],
  "properties": {
    "schema": { "const": "xz-managed-token-rotation-preflight-v1" },
    "result": { "const": "SOFTWARE_PREFLIGHT_PASS" },
    "software_only": { "const": true },
    "domain": { "enum": ["voice", "agent", "ota"] },
    "transition": { "enum": ["rotate", "forward-recovery"] },
    "observed_at_unix": { "$ref": "#/$defs/time" },
    "max_token_ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "current_revision": { "type": "integer", "minimum": 1 },
    "target_revision": { "type": "integer", "minimum": 2 },
    "current_active_key_id": { "$ref": "#/$defs/keyId" },
    "target_active_key_id": { "$ref": "#/$defs/keyId" },
    "cutover_unix": { "$ref": "#/$defs/time" },
    "minimum_drain_until_unix": { "$ref": "#/$defs/time" },
    "old_key_verify_until_unix": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]*$"
    },
    "time": {
      "type": "integer",
      "minimum": 1577836800,
      "exclusiveMaximum": 4102444800
    }
  }
}
