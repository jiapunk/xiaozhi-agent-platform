{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xiaozhi-agent/firmware-origin-catalog-v1.schema.json",
  "title": "XiaoZhi Agent immutable firmware origin catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objects"],
  "properties": {
    "version": { "const": 1 },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release_id", "image_sha256", "image_size", "url_path",
          "image_file"
        ],
        "properties": {
          "release_id": {
            "type": "string", "minLength": 1, "maxLength": 64,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "image_sha256": {
            "type": "string", "pattern": "^[0-9a-f]{64}$"
          },
          "image_size": {
            "type": "integer", "minimum": 1024, "maximum": 2147483647
          },
          "url_path": {
            "type": "string", "minLength": 2, "maxLength": 512,
            "pattern": "^/[A-Za-z0-9/_.-]+\\.bin$"
          },
          "image_file": {
            "type": "string", "minLength": 1, "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          }
        }
      }
    }
  }
}
