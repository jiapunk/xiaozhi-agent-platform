{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xiaozhi-agent/ota-rollout-approver-keyring-v1.schema.json",
  "title": "XiaoZhi Agent OTA rollout approver keyring v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "approvers"],
  "properties": {
    "version": { "const": 1 },
    "approvers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approver_id", "approval_key_id", "public_key_file", "enabled"
        ],
        "properties": {
          "approver_id": { "$ref": "#/$defs/identifier" },
          "approval_key_id": { "$ref": "#/$defs/identifier" },
          "public_key_file": { "$ref": "#/$defs/path" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9:_.-]+$"
    },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    }
  }
}
