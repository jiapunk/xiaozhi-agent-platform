{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-agent.local/schemas/provider-revocation-qualification-config-v1.json",
  "title": "M72 live provider credential revocation config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "qualification_id": { "$ref": "#/$defs/identifier64" },
    "environment": { "enum": ["staging", "production"] },
    "acknowledge_live_credential_revocation": { "const": true },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": { "enum": ["apns-development", "apns-production", "fcm"] },
          "application_id": { "$ref": "#/$defs/identifier128" },
          "team_id": { "type": "string", "minLength": 10, "maxLength": 10 },
          "revoked_credential_id": { "$ref": "#/$defs/credential" },
          "revoked_credential_file": { "$ref": "#/$defs/path" },
          "active_credential_id": { "$ref": "#/$defs/credential" },
          "active_credential_file": { "$ref": "#/$defs/path" },
          "valid_target_file": { "$ref": "#/$defs/path" }
        },
        "required": [
          "platform", "application_id", "revoked_credential_id",
          "revoked_credential_file", "active_credential_id",
          "active_credential_file", "valid_target_file"
        ],
        "allOf": [
          {
            "if": {
              "properties": { "platform": { "enum": ["apns-development", "apns-production"] } },
              "required": ["platform"]
            },
            "then": { "required": ["team_id"] },
            "else": { "not": { "required": ["team_id"] } }
          }
        ]
      }
    }
  },
  "required": [
    "schema", "qualification_id", "environment",
    "acknowledge_live_credential_revocation", "providers"
  ],
  "allOf": [
    {
      "if": { "properties": { "environment": { "const": "production" } }, "required": ["environment"] },
      "then": {
        "properties": {
          "providers": {
            "items": { "properties": { "platform": { "enum": ["apns-production", "fcm"] } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier64": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$" },
    "identifier128": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "credential": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$" },
    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 }
  }
}
