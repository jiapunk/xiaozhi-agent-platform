FROM golang:1.26-bookworm AS builder

WORKDIR /source
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
    -o /out/s3camdevgateway ./cmd/s3camdevgateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home gateway
COPY --from=builder /out/s3camdevgateway /usr/local/bin/s3camdevgateway

USER 10001:10001
EXPOSE 8766
ENTRYPOINT ["/usr/local/bin/s3camdevgateway"]
