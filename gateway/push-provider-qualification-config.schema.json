{
  "$id": "https://xiaozhi-agent.local/schemas/push-provider-qualification-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "environment": { "const": "production" } },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "providers": {
            "items": {
              "properties": {
                "platform": { "enum": ["apns-production", "fcm"] }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "acknowledge_live_provider_calls": { "const": true },
    "environment": { "enum": ["staging", "production"] },
    "providers": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "platform": { "enum": ["apns-development", "apns-production"] }
              },
              "required": ["platform"]
            },
            "then": { "required": ["team_id"] },
            "else": { "not": { "required": ["team_id"] } }
          }
        ],
        "properties": {
          "application_id": { "$ref": "#/$defs/identifier128" },
          "current_credential_file": { "$ref": "#/$defs/path" },
          "current_credential_id": { "$ref": "#/$defs/identifier128" },
          "next_credential_file": { "$ref": "#/$defs/path" },
          "next_credential_id": { "$ref": "#/$defs/identifier128" },
          "platform": { "enum": ["apns-development", "apns-production", "fcm"] },
          "team_id": { "maxLength": 10, "minLength": 10, "type": "string" },
          "valid_target_file": { "$ref": "#/$defs/path" }
        },
        "required": ["platform", "application_id", "current_credential_id", "current_credential_file", "next_credential_id", "next_credential_file", "valid_target_file"],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "qualification_id": { "$ref": "#/$defs/identifier64" },
    "schema": { "const": 1 }
  },
  "required": ["schema", "qualification_id", "environment", "acknowledge_live_provider_calls", "providers"],
  "type": "object",
  "$defs": {
    "identifier64": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$", "type": "string" },
    "identifier128": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "type": "string" },
    "path": { "maxLength": 4096, "minLength": 1, "type": "string" }
  }
}
