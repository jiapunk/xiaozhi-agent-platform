{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-agent.local/schemas/managed-database-attestation-v1.json",
  "title": "M73 signed managed PostgreSQL control-plane attestation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "qualification_id": { "$ref": "managed-database-failover-config.schema.json#/$defs/identifier64" },
    "result": { "enum": ["LIVE_MANAGED_POSTGRESQL_CONTROL_PLANE_PASS", "FIXTURE_MANAGED_POSTGRESQL_ATTESTATION_PASS"] },
    "environment": { "enum": ["staging", "production"] },
    "development_only": { "type": "boolean" },
    "attestation_provider": { "enum": ["fixture", "managed-postgresql-audit-authority"] },
    "run_binding_sha256": { "$ref": "managed-database-failover-observation.schema.json#/$defs/sha256" },
    "failover_observation_sha256": { "$ref": "managed-database-failover-observation.schema.json#/$defs/sha256" },
    "restore_observation_sha256": { "$ref": "managed-database-failover-observation.schema.json#/$defs/sha256" },
    "provider_audit_evidence_sha256": { "$ref": "managed-database-failover-observation.schema.json#/$defs/sha256" },
    "worm_record_id": { "$ref": "managed-database-failover-config.schema.json#/$defs/identifier128" },
    "failover_started_at": { "$ref": "managed-database-failover-observation.schema.json#/$defs/timestamp" },
    "failover_completed_at": { "$ref": "managed-database-failover-observation.schema.json#/$defs/timestamp" },
    "restore_completed_at": { "$ref": "managed-database-failover-observation.schema.json#/$defs/timestamp" },
    "rpo_target_seconds": { "$ref": "managed-database-provider-audit.schema.json#/$defs/slo" },
    "rto_target_seconds": { "$ref": "managed-database-provider-audit.schema.json#/$defs/slo" },
    "databases": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "managed-database-provider-audit.schema.json#/$defs/database" } },
    "managed_service_control_plane_verified": { "type": "boolean" },
    "failover_operator_event_verified": { "type": "boolean" },
    "automated_backups_verified": { "type": "boolean" },
    "point_in_time_restore_verified": { "type": "boolean" },
    "encryption_at_rest_verified": { "type": "boolean" },
    "restore_isolation_verified": { "type": "boolean" },
    "worm_retention_verified": { "type": "boolean" },
    "verified_at": { "$ref": "managed-database-failover-observation.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "managed-database-failover-observation.schema.json#/$defs/timestamp" },
    "signing_key_id": { "$ref": "managed-database-failover-config.schema.json#/$defs/identifier64" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "required": ["schema", "qualification_id", "result", "environment", "development_only", "attestation_provider", "run_binding_sha256", "failover_observation_sha256", "restore_observation_sha256", "provider_audit_evidence_sha256", "worm_record_id", "failover_started_at", "failover_completed_at", "restore_completed_at", "rpo_target_seconds", "rto_target_seconds", "databases", "managed_service_control_plane_verified", "failover_operator_event_verified", "automated_backups_verified", "point_in_time_restore_verified", "encryption_at_rest_verified", "restore_isolation_verified", "worm_retention_verified", "verified_at", "expires_at", "signing_key_id", "signature_algorithm", "signature_b64url"]
}
