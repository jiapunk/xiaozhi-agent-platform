{
  "$id": "https://xiaozhi-agent.local/schemas/push-provider-qualification-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "development_only": { "const": true } }, "required": ["development_only"] },
      "then": {
        "properties": {
          "environment": { "const": "staging" },
          "result": { "const": "FIXTURE_PROTOCOL_PASS" }
        }
      },
      "else": { "properties": { "result": { "const": "LIVE_PROVIDER_API_PASS" } } }
    }
  ],
  "properties": {
    "config_sha256": { "$ref": "#/$defs/sha256" },
    "development_only": { "type": "boolean" },
    "environment": { "enum": ["staging", "production"] },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "production_ready": { "const": false },
    "providers": {
      "items": { "$ref": "#/$defs/provider" },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "qualification_id": { "$ref": "#/$defs/identifier64" },
    "qualification_tool_sha256": { "$ref": "#/$defs/sha256" },
    "result": { "enum": ["FIXTURE_PROTOCOL_PASS", "LIVE_PROVIDER_API_PASS"] },
    "schema": { "const": 1 },
    "secret_free": { "const": true },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_b64url": { "pattern": "^[A-Za-z0-9_-]{86}$", "type": "string" },
    "signing_key_id": { "$ref": "#/$defs/identifier64" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "unresolved_production_gates": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        { "const": "end_to_end_mtls_dispatch" },
        { "const": "managed_database_failover" },
        { "const": "provider_credential_revocation" },
        { "const": "signed_app_delivery_receipt" }
      ],
      "type": "array"
    }
  },
  "required": [
    "schema",
    "qualification_id",
    "result",
    "environment",
    "config_sha256",
    "qualification_tool_sha256",
    "started_at",
    "finished_at",
    "development_only",
    "secret_free",
    "providers",
    "production_ready",
    "unresolved_production_gates",
    "signing_key_id",
    "signature_algorithm",
    "signature_b64url"
  ],
  "type": "object",
  "$defs": {
    "identifier64": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$", "type": "string" },
    "identifier128": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "type": "string" },
    "latency": { "maximum": 15000, "minimum": 0, "type": "integer" },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "application_id": { "$ref": "#/$defs/identifier128" },
        "canceled_request_retried": { "const": true },
        "current_accepted": { "const": true },
        "current_credential_id": { "$ref": "#/$defs/identifier128" },
        "current_latency_ms": { "$ref": "#/$defs/latency" },
        "invalid_classification_ms": { "$ref": "#/$defs/latency" },
        "invalid_target_classified": { "const": true },
        "next_accepted": { "const": true },
        "next_credential_id": { "$ref": "#/$defs/identifier128" },
        "next_latency_ms": { "$ref": "#/$defs/latency" },
        "platform": { "enum": ["apns-development", "apns-production", "fcm"] }
      },
      "required": [
        "platform",
        "application_id",
        "current_credential_id",
        "next_credential_id",
        "current_accepted",
        "next_accepted",
        "invalid_target_classified",
        "canceled_request_retried",
        "current_latency_ms",
        "next_latency_ms",
        "invalid_classification_ms"
      ],
      "type": "object"
    },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "timestamp": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string" }
  }
}
