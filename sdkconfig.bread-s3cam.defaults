# Detected physical board: ESP32-S3, 16 MiB Quad flash, 8 MiB Octal PSRAM.
CONFIG_PRODUCT_BOARD_BREAD_COMPACT_WIFI_S3CAM=y
CONFIG_PRODUCT_SKU_BREAD_COMPACT_WIFI_S3CAM_DEVKIT=y
CONFIG_PRODUCT_HARDWARE_REVISION=1
CONFIG_PRODUCT_BREAD_S3CAM_BRINGUP_ENABLE=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB_bread_s3cam.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Match XiaoZhi 2.1.0's proven GC0308 DVP camera stack exactly.
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_GC0308=y
CONFIG_CAMERA_GC0308_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC0308_DVP_YUV422_320X240_20FPS=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.26.11-online-music"
CONFIG_HTTP_REUSE_ENABLE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Local-LAN Gateway qualification. Restore the official URL and disable this
# insecure switch before creating an Internet-connected or shipping image.
CONFIG_PRODUCT_BREAD_S3CAM_VOICE_BOOTSTRAP_URL="https://116-206-93-12.sslip.io:8443/xiaozhi/ota/"
CONFIG_PRODUCT_BREAD_S3CAM_BOOTSTRAP_TOKEN=""
# CONFIG_PRODUCT_BREAD_S3CAM_ALLOW_INSECURE_VOICE_GATEWAY is not set

# This diagnostic must remain reversible and development-only.
CONFIG_PRODUCT_LIVE_RUNTIME_ENABLE=n
CONFIG_PRODUCT_PRODUCTION_SECURITY_PROFILE=n
CONFIG_PRODUCT_STORAGE_REQUIRE_HMAC_NVS_ENCRYPTION=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
